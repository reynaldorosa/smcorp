# ====================================
# SMCORP - Variáveis de Ambiente
# ====================================
# Copie este arquivo para .env e preencha os valores
# Uso: docker compose up -d (lê o .env da raiz)

# ====================================
# BANCO DE DADOS
# ====================================
DB_USER=smcorp
DB_PASSWORD=smcorp123
DB_NAME=smcorp_db
DB_HOST=postgres
DB_PORT=5432

# URL completa para Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ====================================
# JWT / AUTENTICAÇÃO
# ====================================
# IMPORTANTE: Em produção, use chaves seguras de pelo menos 32 caracteres
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====================================
# CRIPTOGRAFIA DE DADOS SENSÍVEIS (SMTP/WhatsApp/dados bancários)
# ====================================
# IMPORTANTE: Em produção NÃO pode ficar vazio — o backend recusa iniciar
# sem estas variáveis. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-generate-32-bytes-hex
ENCRYPTION_SALT=change-me-generate-another-32-bytes-hex

# ====================================
# BACKEND
# ====================================
NODE_ENV=development
# Porta interna do backend (main.ts lê PORT, não BACKEND_PORT)
PORT=3001

# URL pública do app (usada no PDF do certificado / link de verificação)
APP_URL=http://localhost:3005
# Nome da instituição exibido no certificado
INSTITUTION_NAME=SMCORP

# ====================================
# UNIQ SUPORTE CONNECT (SMS/WhatsApp/Email)
# ====================================
# API de comunicação multi-canal (https://connect.uniqsuporte.com.br)
# Auth: header Api-key (ou MESSAGING_API_KEY_HEADER customizado)
MESSAGING_API_URL=https://connect.uniqsuporte.com.br
MESSAGING_API_KEY=
MESSAGING_API_KEY_HEADER=Api-key

# ====================================
# MERCADO PAGO (billing SaaS + checkout PIX)
# ====================================
# Access token da conta da plataforma (obrigatório para billing/pagamentos online)
MERCADO_PAGO_ACCESS_TOKEN=
# Secret para verificação HMAC dos webhooks (obrigatório em produção)
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública que recebe os webhooks (padrão: {APP_URL}/api/v1/webhooks/mercadopago)
# MERCADO_PAGO_WEBHOOK_URL=https://api.suaempresa.com.br/api/v1/webhooks/mercadopago

# ====================================
# FRONTEND
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=SMCORP
NEXT_PUBLIC_APP_VERSION=1.0.0
# Base URL do fluxo público de matrícula (link do aluno)
NEXT_PUBLIC_PUBLIC_ENROLLMENT_BASE_URL=http://localhost:3005

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ====================================
# CORS
# ====================================
# Origem do frontend (docker-compose publica em :3005)
CORS_ORIGIN=http://localhost:3005

# ====================================
# REDIS (futuro)
# ====================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ====================================
# EMAIL (futuro — SMTP configurável pela UI de Configurações)
# ====================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@smcorp.com.br
