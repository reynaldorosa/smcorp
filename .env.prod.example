# ============================================
# SMCORP - Variáveis de Ambiente (PRODUÇÃO)
# ============================================
# 1) Copie este arquivo para .env.prod
# 2) Preencha TODOS os valores abaixo (nunca versione o .env.prod!)
# 3) Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ============================================

# ---- Banco de Dados EXTERNO ----
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DB?schema=public
# Exemplos:
#   Supabase:    postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#   Railway:     postgresql://postgres:senha@viaduct.proxy.rlwy.net:12345/railway
#   Neon:        postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   AWS RDS:     postgresql://admin:pass@mydb.xxx.sa-east-1.rds.amazonaws.com:5432/smcorp
#   Azure:       postgresql://admin@server:pass@server.postgres.database.azure.com:5432/smcorp?sslmode=require
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DB?schema=public

# ---- JWT (OBRIGATÓRIO - gere chaves seguras!) ----
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE-64-bytes-hex-aleatorios
JWT_REFRESH_SECRET=GERE-64-bytes-hex-aleatorios-diferente
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CRIPTOGRAFIA DE DADOS SENSÍVEIS (SMTP/WhatsApp/dados bancários) ----
# OBRIGATÓRIO: sem estas variáveis o backend NÃO inicia em produção.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=GERE-32-bytes-hex
ENCRYPTION_SALT=GERE-32-bytes-hex-diferente

# ---- Migrations / Seed ----
RUN_MIGRATIONS=true
SEED_ON_STARTUP=false

# ---- Admin / Master (usado apenas no seed) ----
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=TROQUE-esta-senha
MASTER_EMAIL=master@suaempresa.com.br
MASTER_PASSWORD=TROQUE-esta-senha

# ---- CORS ----
# Domínio do frontend em produção
CORS_ORIGIN=https://app.suaempresa.com.br

# ---- Frontend ----
# URL da API acessível pelo BROWSER (não o container)
NEXT_PUBLIC_API_URL=https://api.suaempresa.com.br/api/v1
NEXT_PUBLIC_APP_NAME=SMCORP
# Base URL do fluxo público de matrícula (link do aluno)
NEXT_PUBLIC_PUBLIC_ENROLLMENT_BASE_URL=https://app.suaempresa.com.br
NEXT_BUILD_IGNORE_LINT=true

# ---- URL pública do app (PDF do certificado / link de verificação) ----
APP_URL=https://app.suaempresa.com.br
INSTITUTION_NAME=SMCORP

# ---- Uniq Suporte Connect (SMS/WhatsApp/Email) ----
# API multi-canal: https://connect.uniqsuporte.com.br (auth via header Api-key)
MESSAGING_API_URL=https://connect.uniqsuporte.com.br
MESSAGING_API_KEY=CHAVE-DA-API-UNIQ-SUPORTE
MESSAGING_API_KEY_HEADER=Api-key

# ---- Mercado Pago (billing SaaS + checkout PIX de matrículas) ----
# Access token da conta da plataforma
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx
# Secret para verificação HMAC dos webhooks (OBRIGATÓRIO em produção)
MERCADO_PAGO_WEBHOOK_SECRET=GERE-uma-chave-aleatoria
# URL pública que recebe os webhooks (geralmente a URL da API)
MERCADO_PAGO_WEBHOOK_URL=https://api.suaempresa.com.br/api/v1/webhooks/mercadopago

# ---- Portas (opcional) ----
HTTP_PORT=80
HTTPS_PORT=443
